<%- include('./partials/head', { title: title }) %>
<%- include('./partials/navbar') %>

<main class="container">

    <div class="page-header">

        <div>
            <h1>Dashboard administrativo</h1>

            <p>
                Resumen general del estado de DocuMind.
            </p>
        </div>

    </div>

    <!-- Indicadores principales -->

    <div class="dashboard-grid">

        <div class="dashboard-card">
            <h3>Usuarios</h3>
            <strong><%= estadisticas.usuarios %></strong>
            <p>Usuarios activos</p>
        </div>

        <div class="dashboard-card">
            <h3>Repositorios</h3>
            <strong><%= estadisticas.repositorios %></strong>
            <p>Repositorios activos</p>
        </div>

        <div class="dashboard-card">
            <h3>Documentos</h3>
            <strong><%= estadisticas.documentos %></strong>
            <p>Documentos registrados</p>
        </div>

        <div class="dashboard-card">
            <h3>Procesados</h3>
            <strong><%= estadisticas.procesados %></strong>
            <p>Documentos procesados</p>
        </div>

        <div class="dashboard-card">
            <h3>Pendientes</h3>
            <strong><%= estadisticas.pendientes %></strong>
            <p>Documentos pendientes</p>
        </div>

        <div class="dashboard-card">
            <h3>Con errores</h3>
            <strong><%= estadisticas.errores %></strong>
            <p>Documentos con errores</p>
        </div>

    </div>

    <!-- Documentos por categoría -->

    <div class="dashboard-section">

        <h2>Documentos por categoría</h2>

        <% if (categorias.length === 0) { %>

            <div class="empty-state">
                <p>No hay documentos registrados.</p>
            </div>

        <% } else { %>

            <div class="dashboard-list">

                <% categorias.forEach(categoria => { %>

                    <div class="dashboard-list-item">

                        <span>
                            <%= categoria.categoria %>
                        </span>

                        <strong>
                            <%= categoria.cantidad %>
                        </strong>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

    <!-- Documentos por formato -->

    <div class="dashboard-section">

        <h2>Documentos por formato</h2>

        <% if (formatos.length === 0) { %>

            <div class="empty-state">
                <p>No hay documentos registrados.</p>
            </div>

        <% } else { %>

            <div class="dashboard-list">

                <% formatos.forEach(formato => { %>

                    <div class="dashboard-list-item">

                        <span>
                            <%= formato.formato %>
                        </span>

                        <strong>
                            <%= formato.cantidad %>
                        </strong>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</main>

<%- include('./partials/footer') %>