<%- include('partials/head', { title: 'Iniciar sesión' }) %>

<%- include('partials/navbar') %>

<main>

    <div class="form-container">

        <div class="card">

            <h1>Iniciar sesión</h1>

            <p class="form-description">
                Ingresa tus credenciales para acceder a DocuMind.
            </p>


            <% if (error) { %>
                <div class="alert alert-error">
                    <%= error %>
                </div>
            <% } %>


            <form action="/auth/login" method="POST">

                <div class="form-group">

                    <label for="email">
                        Correo electrónico
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-control"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-control"
                        required
                    >

                </div>


                <button type="submit" class="btn btn-primary">
                    Iniciar sesión
                </button>

            </form>


            <p style="margin-top: 20px;">
                ¿No tienes una cuenta?
                <a href="/auth/registro">Registrarse</a>
            </p>

        </div>

    </div>

</main>

<%- include('partials/footer') %>