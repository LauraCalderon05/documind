<%- include('../partials/head', { title: documento.nombre_original }) %>
    <%- include('../partials/navbar') %>

        <main class="container">

            <div class="page-header">

                <div>
                    <h1>
                        <%= documento.nombre_original %>
                    </h1>

                    <p>
                        Información del documento
                    </p>
                </div>

            </div>


            <!-- Información general -->

            <div class="card">

                <h2>Información general</h2>

                <div class="form-group">
                    <strong>Nombre:</strong>
                    <%= documento.nombre_original %>
                </div>

                <div class="form-group">
                    <strong>Extensión:</strong>
                    <%= documento.extension.toUpperCase() %>
                </div>

                <div class="form-group">
                    <strong>Tamaño:</strong>
                    <%= (documento.tamano / 1024).toFixed(2) %> KB
                </div>

                <div class="form-group">
                    <strong>Repositorio:</strong>
                    <%= documento.nombre_repositorio %>
                </div>

                <div class="form-group">
                    <strong>Carpeta:</strong>
                    <%= documento.nombre_carpeta %>
                </div>

                <div class="form-group">
                    <strong>Fecha de carga:</strong>
                    <%= documento.fecha_carga %>
                </div>

                <div class="form-group">
                    <strong>Estado de procesamiento:</strong>
                    <%= documento.estado_procesamiento || 'PENDIENTE' %>
                </div>
                <div class="form-group">
                    <strong>Tipo de documento:</strong>
                    <%= documento.tipo_documento || 'PENDIENTE' %>
                </div>

                <div class="repository-actions">

                    <a href="/documentos/<%= documento.id_documento %>/descargar" class="btn btn-primary">
                        Descargar
                    </a>

                    <a href="/repositorios/<%= documento.id_repositorio %>/carpetas/<%= documento.id_carpeta %>"
                        class="btn btn-secondary">
                        Volver a la carpeta
                    </a>

                </div>

            </div>


            <!-- Texto extraído -->

            <div class="card document-content-card">

                <h2>Texto extraído</h2>

                <% if (documento.estado_procesamiento==='PROCESADO' && documento.texto_extraido) { %>

                    <div class="texto-extraido">
                        <%= documento.texto_extraido %>
                    </div>

                    <% } else if (documento.estado_procesamiento==='PROCESANDO' ) { %>

                        <p>
                            El documento está siendo procesado.
                            El texto estará disponible cuando finalice el procesamiento.
                        </p>

                        <% } else if (documento.estado_procesamiento==='ERROR' ) { %>

                            <p>
                                No fue posible extraer el texto de este documento.
                            </p>

                            <% } else if (documento.tipo_documento==='OTRO' &&
                                documento.estado_procesamiento==='PROCESADO' ) { %>

                                <p>
                                    Este documento fue analizado correctamente, pero no pertenece
                                    a las categorías principales de DocuMind, por lo que no se
                                    extrajeron campos específicos.
                                </p>

                                <% } else { %>

                                    <p>
                                        No hay información relevante disponible.
                                    </p>

                                    <% } %>

            </div>


            <!-- Espacio reservado para análisis de IA -->

            <div class="card document-content-card">

                <h2>Resumen generado por IA</h2>

                <% if (documento.resumen) { %>

                    <div class="ai-summary">
                        <p>
                            <%= documento.resumen %>
                        </p>
                    </div>

                    <% } else if (documento.estado_procesamiento==='PROCESANDO' ) { %>

                        <p>
                            El documento está siendo analizado por DocuMind.
                        </p>

                        <% } else if (documento.estado_procesamiento==='ERROR' ) { %>

                            <p>
                                No fue posible generar el análisis del documento.
                            </p>

                            <% } else { %>

                                <p>
                                    El análisis todavía no está disponible.
                                </p>

                                <% } %>

            </div>


            <div class="card document-content-card">

                <h2>Información relevante</h2>

                <% if ( documento.informacion_relevante && Object.keys(documento.informacion_relevante).length> 0
                    ) { %>

                    <div class="informacion-relevante">

                        <% Object.entries(documento.informacion_relevante).forEach(([campo, valor])=> { %>

                            <div class="dato-ia">

                                <strong>
                                    <%= campo %>
                                </strong>

                                <p>
                                    <%= valor %>
                                </p>

                            </div>

                            <% }) %>

                    </div>

                    <% } else if (documento.estado_procesamiento==='PROCESANDO' ) { %>

                        <p>
                            La información relevante estará disponible
                            cuando finalice el análisis.
                        </p>

                        <% } else { %>

                            <p>
                                No hay información relevante disponible.
                            </p>

                            <% } %>

            </div>


            <!-- Chat de preguntas al documento -->

            <% if ( documento.estado_procesamiento==='PROCESADO' && ['CONTRATO', 'FACTURA' , 'INFORME'
                ].includes(documento.tipo_documento) ) { %>

                <!-- Botón flotante -->

                <button type="button" id="boton-chat-documento" class="boton-chat-documento"
                    aria-label="Abrir asistente de DocuMind">
                    IA
                </button>


                <!-- Ventana del chat -->

                <div id="ventana-chat-documento" class="ventana-chat-documento">

                    <!-- Encabezado -->

                    <div class="chat-header">

                        <div>
                            <strong>
                                DocuMind IA
                            </strong>

                            <span>
                                Pregunta sobre este documento
                            </span>
                        </div>

                        <button type="button" id="cerrar-chat-documento" class="chat-cerrar" aria-label="Cerrar chat">
                            ×
                        </button>

                    </div>


                    <!-- Mensajes -->

                    <div id="mensajes-chat-documento" class="mensajes-chat-documento">

                        <div class="mensaje-chat mensaje-ia">

                            <div class="mensaje-contenido">

                                Puedes preguntarme sobre el contenido
                                de este documento.

                            </div>

                        </div>

                    </div>


                    <!-- Indicador -->

                    <div id="indicador-chat-documento" class="indicador-chat-documento">
                        DocuMind está analizando tu pregunta...
                    </div>


                    <!-- Formulario -->

                    <form id="formulario-chat-documento" action="/documentos/<%= documento.id_documento %>/preguntar"
                        method="POST" class="formulario-chat-documento">

                        <textarea id="pregunta-documento" name="pregunta" rows="2" placeholder="Escribe tu pregunta..."
                            maxlength="1000" required></textarea>

                        <button type="submit" class="boton-enviar-chat">
                            Enviar
                        </button>

                    </form>

                </div>

                <% } else if ( documento.tipo_documento==='OTRO' || documento.tipo_documento==='PENDIENTE' ) { %>

                    <div class="card document-content-card">

                        <h2>Preguntas al documento</h2>

                        <p>
                            Las preguntas en lenguaje natural están disponibles
                            únicamente para documentos clasificados como
                            contrato, factura o informe.
                        </p>

                    </div>

                    <% } %>


                        <script src="/js/chatDocumento.js" defer></script>

        </main>

        <%- include('../partials/footer') %>