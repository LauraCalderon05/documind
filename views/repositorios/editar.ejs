<%- include('../partials/head', { title: 'Editar repositorio' }) %>
<%- include('../partials/navbar') %>

<main>

    <div class="form-container">

        <div class="card">

            <h1>Editar repositorio</h1>

            <p class="form-description">
                Modifica la información del repositorio.
            </p>

            <form
                action="/repositorios/editar/<%= repositorio.id_repositorio %>"
                method="POST"
            >

                <div class="form-group">

                    <label for="nombre">
                        Nombre
                    </label>

                    <input
                        type="text"
                        id="nombre"
                        name="nombre"
                        class="form-control"
                        maxlength="100"
                        value="<%= repositorio.nombre %>"
                        required
                    >

                </div>

                <div class="form-group">

                    <label for="descripcion">
                        Descripción
                    </label>

                    <textarea
                        id="descripcion"
                        name="descripcion"
                        class="form-control"
                        maxlength="255"
                        rows="4"
                    ><%= repositorio.descripcion || '' %></textarea>

                </div>

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Guardar cambios
                </button>

                <a
                    href="/repositorios"
                    class="btn btn-secondary"
                >
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</main>

<%- include('../partials/footer') %>