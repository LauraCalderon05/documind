<%- include('../partials/head', { title: 'Editar carpeta' }) %>
<%- include('../partials/navbar') %>
<main class="container">

    <div class="form-container">

        <h1>Editar carpeta</h1>

        <p>
            Repositorio:
            <strong><%= carpeta.nombre_repositorio %></strong>
        </p>

        <form
            action="/repositorios/<%= carpeta.id_repositorio %>/carpetas/<%= carpeta.id_carpeta %>/editar"
            method="POST"
        >

            <div class="form-group">

                <label for="nombre">
                    Nombre de la carpeta
                </label>

                <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    class="form-control"
                    value="<%= carpeta.nombre %>"
                    maxlength="100"
                    required
                >

            </div>


            <div class="form-group">

                <label for="descripcion">
                    Descripción
                </label>

                <textarea
                    id="descripcion"
                    name="descripcion"
                    class="form-control"
                    maxlength="255"
                    rows="4"
                ><%= carpeta.descripcion || '' %></textarea>

            </div>


            <div class="repository-actions">

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Guardar cambios
                </button>

                <a
                    href="/repositorios/<%= carpeta.id_repositorio %>"
                    class="btn btn-secondary"
                >
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</main>

<%- include('../partials/footer') %>