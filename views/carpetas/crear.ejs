<%- include('../partials/head', { title: 'Crear Carpeta' }) %>
<%- include('../partials/navbar') %>

<main class="container">

    <div class="form-container">

        <h1>Crear carpeta</h1>

        <p>
            Repositorio:
            <strong><%= repositorio.nombre %></strong>
        </p>

        <form
            action="/repositorios/<%= repositorio.id_repositorio %>/carpetas/crear"
            method="POST"
        >

            <div class="form-group">
                <label for="nombre">Nombre de la carpeta</label>

                <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    class="form-control"
                    required
                    maxlength="100"
                >
            </div>

            <div class="form-group">
                <label for="descripcion">Descripción</label>

                <textarea
                    id="descripcion"
                    name="descripcion"
                    class="form-control"
                    maxlength="255"
                    rows="4"
                ></textarea>
            </div>

            <div class="repository-actions">

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Crear carpeta
                </button>

                <a
                    href="/repositorios/<%= repositorio.id_repositorio %>/carpetas"
                    class="btn btn-secondary"
                >
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</main>

<%- include('../partials/footer') %>